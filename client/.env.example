# ─────────────────────────────────────────────────────────────
# Client environment variables
#
# For LOCAL development this is not needed (the Vite proxy
# forwards /api calls to localhost:3001 automatically).
#
# For PRODUCTION (Vercel), set VITE_API_BASE_URL in the
# Vercel dashboard to point to your deployed backend URL.
# Example: https://ai-order-server.up.railway.app
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:3001
